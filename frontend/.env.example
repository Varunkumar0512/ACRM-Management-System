# Google OAuth 2.0 Web Client ID (Public client ID used by Google Identity Services)
# IMPORTANT: Never place client secrets or backend private keys in VITE_ environment variables.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API endpoint (e.g. deployed on Render: https://acrm-backend.onrender.com)
# Defaults to local dev proxy (/api/v1) when not specified.
VITE_API_URL=https://your-acrm-backend.onrender.com
