# Google OAuth 2.0 Web Client ID (Public client ID used by Google Identity Services)
# IMPORTANT: Never place client secrets or backend private keys in VITE_ environment variables.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional custom backend API endpoint (default proxies to /api via Vite dev server)
# VITE_API_URL=http://localhost:5000/api/v1
