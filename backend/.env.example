NODE_ENV=development
PORT=5000
# Allowed CORS origins (comma-separated). Defaults to Vercel, localhost:3000, and localhost:5173 if empty.
CORS_ORIGIN=https://acrm-management-system.vercel.app,http://localhost:3000,http://localhost:5173
JWT_ACCESS_SECRET=acr_academic_access_token_secret_super_secure_key_2025_prod_random_key_64bit
JWT_REFRESH_SECRET=acr_academic_refresh_token_secret_super_secure_key_2025_prod_random_key_64bit
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# Google OAuth 2.0 Identity Services Configuration
# The Google Client ID obtained from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs -> Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional comma-separated list of allowed institutional email domains (e.g., university.edu,campus.ac.in). Leave empty to allow any domain.
GOOGLE_ALLOWED_DOMAINS=
