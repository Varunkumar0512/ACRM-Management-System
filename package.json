{
  "name": "automated-campus-research-management",
  "version": "1.0.0",
  "private": true,
  "description": "ACRM — Automated Campus Research Management Platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "seed:projects": "npm run seed:projects --prefix backend",
    "test": "npm run test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
